[Unit]
Description=Kom_Dom_B FastAPI bootstrap API
After=network.target postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/Kom_Dom_B
EnvironmentFile=/var/www/Kom_Dom_B/.env
ExecStart=/var/www/Kom_Dom_B/venv/bin/uvicorn app.main:app --app-dir /var/www/Kom_Dom_B/backend --host 127.0.0.1 --port 8100 --workers 1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
