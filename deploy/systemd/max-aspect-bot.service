[Unit]
Description=MAX Aspect Bot channel adapter
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/komunal-dom_ru
EnvironmentFile=/var/www/komunal-dom_ru/.env
Environment=DJANGO_SETTINGS_MODULE=komunal_dom.settings
ExecStart=/var/www/komunal-dom_ru/venv/bin/python /var/www/komunal-dom_ru/max_bot_service.py --poll
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
